<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The app's privacy manifest (docs/STORE.md, App Privacy). The app's own code collects nothing and
  tracks no one: the weigh-ins stay on the phone. Each required-reason API the app's own code uses is
  listed below with its reason as stories add one (docs/sprint-3.md); Capacitor and its plugins ship
  manifests of their own.
-->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array/>
</dict>
</plist>
