# Two lanes, run from ios/App. `beta` signs the iOS app for the App Store and uploads it to
# TestFlight (the TestFlight workflow, .github/workflows/testflight.yml), after the web build has
# been copied in (`cap sync ios`). `listing` sends the store listing's text and screenshots (the
# App Store listing workflow, .github/workflows/app-store-listing.yml). Everything secret comes
# from the environment; docs/STORE.md (step 3) lists it.

require "base64"
require "tmpdir"

default_platform(:ios)

APP_ID = "net.jonathas.weightogo"
# Google's test AdMob app, until the owner's is set (ADMOB_APP_ID, docs/STORE.md step 6). The
# workflow refuses an App Store build without the owner's ids.
TEST_ADMOB_APP_ID = "ca-app-pub-3940256099942544~1458002511"
# The screenshot folders: the listing's two languages, and the purchase's review screenshot.
LISTING_SCREENSHOT_FOLDERS = ["en-US", "pt-BR", "review"].freeze

platform :ios do
  desc "Build, sign and upload a build to TestFlight"
  lane :beta do
    # A temporary keychain that holds the certificate for this run only.
    setup_ci

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_API_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY_P8"),
      is_key_content_base64: true
    )

    # The certificate is on disk only for the import, outside the repository.
    certificate = File.join(ENV.fetch("RUNNER_TEMP") { Dir.tmpdir }, "distribution.p12")
    begin
      File.binwrite(certificate, Base64.decode64(ENV.fetch("IOS_DISTRIBUTION_CERTIFICATE_P12")))
      import_certificate(
        certificate_path: certificate,
        certificate_password: ENV.fetch("IOS_DISTRIBUTION_CERTIFICATE_PASSWORD"),
        keychain_name: ENV.fetch("MATCH_KEYCHAIN_NAME"),
        keychain_password: ENV.fetch("MATCH_KEYCHAIN_PASSWORD")
      )
    ensure
      File.delete(certificate) if File.exist?(certificate)
    end

    # Makes the App Store profile anew on every run, so it always carries the App ID's current
    # capabilities (HealthKit, turned on in docs/STORE.md step 1).
    get_provisioning_profile(
      api_key: api_key,
      app_identifier: APP_ID,
      team_id: ENV.fetch("APPLE_TEAM_ID"),
      force: true
    )

    update_code_signing_settings(
      path: "App.xcodeproj",
      targets: ["App"],
      use_automatic_signing: false,
      team_id: ENV.fetch("APPLE_TEAM_ID"),
      code_sign_identity: "Apple Distribution",
      profile_uuid: lane_context[SharedValues::SIGH_UUID],
      profile_name: lane_context[SharedValues::SIGH_NAME]
    )

    # Every upload needs a higher build number than the last: run number × 100 + attempt.
    build_number = ENV.fetch("BUILD_NUMBER")
    # The owner's AdMob app and banner unit reach only a run "for the App Store" (the workflow passes
    # them then, with WTG_APP_STORE_BUILD=YES). Installed from TestFlight the app shows Google's test
    # ads anyway (a sandbox receipt, AdSetupPlugin.swift), and the owner's on the App Store. Any
    # other build names Google's test app and shows no ads outside TestFlight.
    app_store_build = ENV["WTG_APP_STORE_BUILD"] == "YES"
    admob_app_id = app_store_build && !ENV["ADMOB_APP_ID"].to_s.empty? ? ENV["ADMOB_APP_ID"] : TEST_ADMOB_APP_ID
    admob_banner_id = app_store_build ? ENV["ADMOB_BANNER_ID"].to_s : ""
    build_app(
      project: "App.xcodeproj",
      scheme: "App",
      configuration: "Release",
      # fastlane's name for an App Store export (Xcode's own, app-store-connect, fails its check).
      export_method: "app-store",
      export_options: { provisioningProfiles: { APP_ID => lane_context[SharedValues::SIGH_NAME] } },
      xcargs: "CURRENT_PROJECT_VERSION='#{build_number}' ADMOB_APP_ID='#{admob_app_id}' " \
              "ADMOB_BANNER_ID='#{admob_banner_id}' WTG_APP_STORE_BUILD='#{app_store_build ? "YES" : "NO"}'",
      output_directory: "build",
      clean: true
    )

    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
    UI.success("Uploaded build #{build_number} to TestFlight")
  end

  # Run by the App Store listing workflow (.github/workflows/app-store-listing.yml) from ios/App:
  # the text in fastlane/metadata and the screenshots in fastlane/screenshots
  # (`npm run store:screenshots`), in English and Brazilian Portuguese (docs/STORE.md, step 8).
  desc "Upload the store listing, its text and screenshots, without a build or a submission"
  lane :listing do
    # Only the listing's languages are sent: screenshots/review holds the in-app purchase's review
    # screenshot (docs/STORE.md, step 5), which App Store Connect takes by hand, and deliver would
    # refuse it as a language. Any other folder is a mistake, stopped here. (The Fastfile's own
    # code runs in fastlane/, its actions in ios/App.)
    folders = Dir.children("screenshots").select { |name| File.directory?(File.join("screenshots", name)) }
    unless folders.sort == LISTING_SCREENSHOT_FOLDERS
      UI.user_error!("Unexpected folders in fastlane/screenshots: #{folders.sort.join(", ")}")
    end
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_API_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY_P8"),
      is_key_content_base64: true
    )
    deliver(
      api_key: api_key,
      app_identifier: APP_ID,
      platform: "ios",
      metadata_path: "./fastlane/metadata",
      screenshots_path: "./fastlane/screenshots",
      # The review folder, checked above, is left out rather than refused.
      ignore_language_directory_validation: true,
      overwrite_screenshots: true,
      skip_binary_upload: true,
      skip_app_version_update: true,
      # Nobody is there to confirm the HTML preview, and nothing goes to review from here.
      force: true,
      submit_for_review: false,
      automatic_release: false,
      run_precheck_before_submit: false
    )
    UI.success("Uploaded the listing's text and screenshots; nothing was submitted for review")
  end
end
