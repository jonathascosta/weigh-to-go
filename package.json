{
  "name": "weigh-to-go",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A weight diary that runs entirely in the browser: weigh-ins stay on your device.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:ios": "tsc -b && vite build --mode ios",
    "ios:sync": "npm run build:ios && cap sync ios",
    "preview": "vite preview",
    "test": "vitest run",
    "check": "tsc -b",
    "lint": "eslint . && prettier --check .",
    "check:dist": "node scripts/check-dist.mjs",
    "e2e": "npm run build && npm run build:ios && playwright test",
    "icons": "node scripts/icons.mjs",
    "lighthouse": "npm ci --prefix tools/lhci && npm run lighthouse:mobile && npm run lighthouse:desktop",
    "lighthouse:mobile": "tools/lhci/node_modules/.bin/lhci autorun --upload.outputDir=lighthouse-report/mobile",
    "lighthouse:desktop": "tools/lhci/node_modules/.bin/lhci autorun --collect.settings.preset=desktop --collect.numberOfRuns=1 --upload.outputDir=lighthouse-report/desktop"
  },
  "engines": {
    "node": "^22.19.0 || ^24.0.0 || >=26.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@capacitor/cli": "^8.5.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@types/d3-array": "^3.2.2",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/d3-time": "^3.0.4",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^21.0.1",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@capacitor-community/in-app-review": "^8.0.0",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "d3-array": "^3.2.4",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "d3-time": "^3.1.0"
  },
  "overrides": {
    "playwright-core": "1.63.0"
  }
}
