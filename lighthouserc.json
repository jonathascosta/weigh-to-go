{
  "ci": {
    "collect": {
      "startServerCommand": "npx vite preview --port 4175 --strictPort",
      "startServerReadyPattern": "localhost:4175",
      "url": [
        "http://localhost:4175/",
        "http://localhost:4175/pt/",
        "http://localhost:4175/privacy.html",
        "http://localhost:4175/pt/privacidade.html"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new",
        "skipAudits": ["robots-txt"]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "warn",
          {
            "minScore": 0.9,
            "aggregationMethod": "median"
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.95
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "lighthouse-report"
    }
  }
}
